# Add these ATLAS_* values to the consumer project environment.
# Docker Hub destination; usable by consumers after the owner publishes this tag.
ATLAS_IMAGE=drlenux/memory-tools:0.1.25
ATLAS_POSTGRES_DB=atlas
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=
ATLAS_AGENT_TOKEN=
ATLAS_REVIEW_TOKEN=

# Host path is mounted read-only at /project. No application source is executed.
ATLAS_HOST_PROJECT_ROOT=.
ATLAS_HOST_PORT=8080
ATLAS_DATABASE_URL=host=127.0.0.1 connect_timeout=5
# Analysis, search and MCP settings live in the project: .atlas/setup.yaml
# (template: examples/setup.yaml). Only secrets, limits and wiring stay here.
ATLAS_CPU_LIMIT=1
# 0 follows ceil(ATLAS_CPU_LIMIT), bounded to 1..32; 1 forces sequential indexing.
ATLAS_INDEX_WORKERS=0
ATLAS_MEMORY_LIMIT_MB=1024
# Compose derives localhost origins from ATLAS_HOST_PORT. Override for a reverse proxy:
# ATLAS_ALLOWED_ORIGINS=["https://atlas.example.com"]
